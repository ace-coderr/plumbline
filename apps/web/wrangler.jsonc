{
  // The static site, served by Cloudflare as a Worker with static assets (no code runs: files only).
  // workers.dev only: no routes, no zones, no custom domains. The runner is a different Worker (packages/runner).
  "name": "plumbline-web",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // A refresh or a shared link to /status, /scorecard/..., /campaign/... gets the app, not a 404.
    // Files that exist (assets, snapshot data, the prerendered /report/<token> pages) are served as they are.
    "not_found_handling": "single-page-application"
  }
}
