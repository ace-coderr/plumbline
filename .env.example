# Plumbline local configuration. Copy to .env and fill in. Never commit .env.

# --- network --------------------------------------------------------------------------------
ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
# Blockscout API behind the Elysium explorer, used by forge verify-contract.
ELYSIUM_VERIFIER_URL=https://testnet-api.elysium.kinetiq.xyz/api/

# --- keys (testnet only) --------------------------------------------------------------------
# Deploys the contracts, sponsors the demo campaign, and funds the other wallets during seeding.
DEPLOYER_PRIVATE_KEY=
# Vault owners: hold withdrawal rights and post bonds.
MAKER_A_PRIVATE_KEY=
MAKER_B_PRIVATE_KEY=
# Hot keys the maker bots quote with. They can post and cancel quotes, never move funds.
QUOTER_A_PRIVATE_KEY=
QUOTER_B_PRIVATE_KEY=
# Pays gas for probes and settlement; earns probe fees.
KEEPER_PRIVATE_KEY=

# --- deploy ---------------------------------------------------------------------------------
PLUMB_MAX_AGE=2
PLUMB_WITHDRAW_DELAY=30

# --- budget (pnpm budget --write fills the SEED_* gas values and the stop floors) -----------
BUDGET_HEADROOM=0.3
BUDGET_KEEPER_HOURS=2
BUDGET_BOT_MINUTES=25
BUDGET_REFRESH_MS=500
BUDGET_EPOCH_SECONDS=300
BUDGET_VAULT_WHYPE=0.001

# --- seed (pnpm seed; --new-campaign opens another campaign on the same vaults) -------------
# Native HYPE sent to each wallet (gas only).
SEED_MAKER_HYPE=0.0003
SEED_QUOTER_HYPE=0.012
SEED_KEEPER_HYPE=0.006
# Inventory: WHYPE per vault (wrapped from HYPE) and PLUMBUSD per vault (minted demo asset).
SEED_VAULT_WHYPE=0.001
SEED_VAULT_QUOTE=0.1
# Campaign terms. Pot and bonds are PLUMBUSD.
SEED_REWARD_PER_EPOCH=50
SEED_EPOCHS=24
SEED_EPOCH_LENGTH=300
SEED_BOND=10
SEED_MAX_SPREAD_BPS=30
SEED_MIN_DEPTH_BASE=0.0005
SEED_MIN_DEPTH_QUOTE=0.02
SEED_MIN_PROBE_INTERVAL=13
SEED_PROBE_FEE_BPS=10
# Register the canonical WHYPE/USDC market on-chain (one empty vault).
SEED_REGISTER_CANONICAL=true
# Gas ledger file tag: data/gas-<chainId>-<tag>.json
SEED_LEDGER_TAG=live
# Pin the fee cap (wei), e.g. on a local fork whose eth_gasPrice differs from Elysium.
# TX_MAX_FEE_WEI=125000000
TX_RECEIPT_POLL_MS=400

# --- keeper ---------------------------------------------------------------------------------
KEEPER_PORT=8787
# The gate opens at random and stays open ~1.1 s (8 L2 blocks); a public-node poll takes ~0.5 s, so several
# pollers run side by side, taking the endpoints in turn. One poller misses most openings (0 of 7 landed).
KEEPER_POLL_MS=100
KEEPER_POLLERS=4
# Optional: comma-separated poll endpoints; empty uses the main and the send endpoint.
# KEEPER_POLL_URLS=
KEEPER_RPC_PER_SECOND=6
# Probes go out on a separate endpoint so they never queue behind gate polls.
KEEPER_SEND_RPC_URL=https://rpc-elysium-testnet.t.conduit.xyz
KEEPER_SEND_RPC_PER_SECOND=6
# Stop sending once the keeper wallet drops below this (wei). 0 disables.
KEEPER_STOP_BELOW_WEI=0
# Comma-separated campaign ids; empty probes every active campaign. Seeding sets this.
KEEPER_CAMPAIGNS=
KEEPER_AUTO_SETTLE=true
KEEPER_CLAIM_THRESHOLD_WEI=100000000000000000

# --- maker bots (MAKER_BOT=A or B picks the MAKER_<A|B>_* block) ----------------------------
HL_INFO_URL=https://api.hyperliquid-testnet.xyz/info
# Bots send the most transactions; give them their own endpoint (and rate-limit bucket).
MAKER_RPC_URL=https://rpc-elysium-testnet.t.conduit.xyz
MAKER_RPC_PER_SECOND=2.4
# Written by pnpm seed.
MAKER_A_VAULT=
MAKER_A_PAIR=WHYPE-PLUMBUSD
MAKER_A_REFERENCE_COIN=HYPE
MAKER_A_SPREAD_BPS=12
MAKER_A_SIZE=0.0008
MAKER_A_SKEW_BPS=4
MAKER_A_REFRESH_MS=500
MAKER_A_PORT=8791
# Cancel and stop once the quoter wallet drops below this (wei). 0 disables. Set by pnpm budget.
MAKER_A_STOP_BELOW_WEI=0

MAKER_B_VAULT=
MAKER_B_PAIR=WHYPE-PLUMBUSD
MAKER_B_REFERENCE_COIN=HYPE
MAKER_B_SPREAD_BPS=24
MAKER_B_SIZE=0.0006
MAKER_B_SKEW_BPS=4
MAKER_B_REFRESH_MS=500
MAKER_B_PORT=8792
MAKER_B_STOP_BELOW_WEI=0
MAKER_MAX_REFERENCE_AGE_MS=5000

# --- demo (pnpm demo) -----------------------------------------------------------------------
DEMO_ROGUE_WHYPE=0.0002
DEMO_FAKE_SPEND=0.01
DEMO_RPC_PER_SECOND=1.5

# --- indexer --------------------------------------------------------------------------------
INDEXER_PORT=8788
INDEXER_RPC_URL=https://rpc-elysium-testnet.t.conduit.xyz
INDEXER_RPC_PER_SECOND=0.8
INDEXER_POLL_MS=3000
INDEXER_SAMPLE_MS=15000
# INDEXER_DB=./data/indexer-99801.sqlite

# --- web ------------------------------------------------------------------------------------
# Hosts usually set PORT; WEB_PORT is the local fallback.
WEB_PORT=8080
# true: run the indexer inside the web process and serve its API at /api (one deployable service).
# false: proxy /api to INDEXER_URL (local development with a separate indexer).
EMBED_INDEXER=false
INDEXER_URL=http://127.0.0.1:8788
# "off" disables the keeper proxy; the dashboard then shows the keeper as offline.
KEEPER_URL=http://127.0.0.1:8787
# Public origin for link-preview (Open Graph) tags. Live server: defaults to
# https://$RAILWAY_PUBLIC_DOMAIN. Static build: defaults to https://$VERCEL_PROJECT_PRODUCTION_URL.
# Set it when you attach a custom domain.
# PUBLIC_URL=https://plumbline.example
# Backfill start for a fresh indexer database; defaults to the contracts' deploy block.
# INDEXER_START_BLOCK=11477778

# --- static snapshot (pnpm export:static) ---------------------------------------------------
# SNAPSHOT_FRESH=1 rebuilds from the deploy block into a throwaway database instead of INDEXER_DB.

# --- Railway, live indexer only (Variables tab; the Dockerfile already defaults these) -------
# EMBED_INDEXER=true
# KEEPER_URL=off
# INDEXER_DB=/data/indexer-99801.sqlite     # /data is the mounted volume
# INDEXER_RPC_URL=https://rpc-elysium-testnet.t.conduit.xyz
# INDEXER_RPC_PER_SECOND=2

# --- live bots (pnpm live:bots) -------------------------------------------------------------
# Spend cap per UTC day across the keeper and both quoter wallets, in HYPE. Stops everything when reached.
LIVE_BOTS_DAILY_HYPE=0.002
# Stop everything (and stay stopped) when any of those wallets falls below this, in HYPE.
LIVE_BOTS_STOP_BELOW_HYPE=0.0002
# Optional: comma-separated campaign ids for the keeper to probe (empty: every active campaign).
# LIVE_BOTS_CAMPAIGNS=

# --- runner (Cloudflare Workers; see docs/OPERATING.md) -------------------------------------
# Local copies of what is also set as Cloudflare secrets. Never commit real values.
# The sponsor wallet's key (opens campaigns, pays the PLUMBUSD pot).
SPONSOR_PRIVATE_KEY=
# The treasury wallet's key (tops the bot wallets up, only to addresses in bots.schedule.json).
TREASURY_PRIVATE_KEY=
# Password for the runner's admin routes (kill, resume, test alert).
ADMIN_TOKEN=
# A private RPC node URL; its API key is inside the URL. Optional, but the runner uses it first.
CONDUIT_RPC_URL=
# Optional: a heartbeat monitor's ping address (for example from healthchecks.io). The runner pings it every 5 minutes while healthy.
HEALTHCHECK_URL=
# Telegram bot token (from @BotFather) and your own chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Your runner's address after the first deploy, used only by pnpm check:all.
RUNNER_URL=
