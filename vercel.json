{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --filter \"@plumbline/web...\"",
  "buildCommand": "pnpm --filter @plumbline/shared build && pnpm --filter @plumbline/web build:static",
  "outputDirectory": "apps/web/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/snapshot/:path*",
      "destination": "/snapshot/:path*"
    },
    {
      "source": "/og/:path*",
      "destination": "/og/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/snapshot/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
