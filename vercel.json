{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --filter \"@plumbline/web...\"",
  "buildCommand": "pnpm --filter @plumbline/shared build && pnpm --filter @plumbline/web build:static",
  "outputDirectory": "apps/web/dist",
  "cleanUrls": true,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/snapshot/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    }
  ]
}
