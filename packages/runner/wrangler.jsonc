{
  "name": "plumbline-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // workers.dev only: no routes, no zones, no custom domains.
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "SUPERVISOR", "class_name": "Supervisor" },
      { "name": "ROLE", "class_name": "Role" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Supervisor", "Role"] }],
  // Wakes the supervisor every minute. It does nothing unless bots.schedule.json says "enabled": true.
  "triggers": { "crons": ["* * * * *"] },
  // Workers Logs: every invocation (alarms, cron, requests) with its outcome, plus the runner's own redacted log lines. The free plan keeps
  // 200,000 events a day for 3 days; the runner makes about 40,000 invocations a day plus under a thousand log lines, so there is room.
  // If a day ever went over, Cloudflare stops logging for the rest of that day; the Worker itself is not affected.
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
